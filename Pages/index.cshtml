@page
@model LibraryApp.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}
@section Styles
{
    <link rel = "stylesheet" href = "~/css/index.css" />
}


<!--- HERO SECTION --->

<div class="hero-section text-center text-white d-flex align-items-center">
    <div class = "container, text-center">
        <h1 class="display-3 fw-bold">
            Library Management System
        </h1>

        <p class="lead mt-3">
            Manage books, loans, and users all in one place.
        </p>

        <div class="mt-4">
            <a asp-page="/Books/Index" class="btn btn-light btn-lg me-3">
                Browse Books
            </a>

            @if(!User.Identity!.IsAuthenticated)
            {
                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="btn btn-outline-light btn-lg me-2">
                    Login
                </a>

                <a asp-area="Identity"
                   asp-page="/Account/Register"
                   class="btn btn-warning btn-lg">
                    Register
                </a>
            }
        </div>
    </div>
</div>

<!--- MAIN CONTENT --->

<div class="container mt-5">

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card h-100 text-center p-3">
                <div class="card-body text">
                    <h3>📚 Books</h3>
                    <p>
                        View and manage the library collection.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 text-center p-3">
                <div class="card-body text">
                    <h3>👥 Users</h3>
                    <p>
                        Student and admin account management.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 text-center p-3">
                <div class="card-body text">
                    <h3>🔄 Loans</h3>
                    <p>
                        Track borrowed and returned books.
                    </p>
                </div>
            </div>
        </div>

    </div>

<! --- NEW BOOKS SECTION --->

    <div class = "row mt-5">
        <div class="col-12 text-center">
            <h2> 
                Whats NEW? 
            </h2>

            <p class = "section-subtitle">
                Exlpore the lastest Books added to our collection!
            </p>

        </div>
    </div>

    <!--- BOOK CARDS --->
    <div class = "row mt-4 g-4">
        
        <!--- BOOK 1 --->
        <div class = "col-md-4">
            <div class = "card h-100">
                <img src = "https://via.placeholder.com/400x500"
                        class = "card-img-top"
                        alt = "Book Cover" />
                <div class = "card-body">
                    
                    <h5 class = "card-title">
                        NEW BOOK TITLE
                    </h5>

                    <p class = "card-text">
                        NEW BOOK DESCRIPTION
                    </p>

                </div>
            </div>
        </div>

        <!--- BOOK 2 --->
        <div class = "col-md-4">
            <div class = "card h-100">
                <img src = "https://via.placeholder.com/400x500"
                        class = "card-img-top"
                        alt = "Book Cover" />
                <div class = "card-body">
                    
                    <h5 class = "card-title">
                        NEW BOOK TITLE
                    </h5>

                    <p class = "card-text">
                        NEW BOOK DESCRIPTION
                    </p>

                </div>
            </div>
        </div>

        <!--- BOOK 3 --->
        <div class = "col-md-4">
            <div class = "card h-100">
                <img src = "https://via.placeholder.com/400x500"
                        class = "card-img-top"
                        alt = "Book Cover" />
                <div class = "card-body">
                    
                    <h5 class = "card-title">
                        NEW BOOK TITLE
                    </h5>

                    <p class = "card-text">
                        NEW BOOK DESCRIPTION
                    </p>

                </div>
            </div>
        </div>
    </div>
</div>